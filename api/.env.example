# Copy to api/.env and fill in. Never commit api/.env.
DATABASE_URL=
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/plasticash_test
DB_POOL_SIZE=5        # pool + overflow under the Supabase session pooler limit (15)
DB_MAX_OVERFLOW=5
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_FAKE_TRANSFERS=false  # local testing only: approve = PAID without Paystack; refused with sk_live_
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=
OTP_SECRET=
CRON_SECRET=
VAPID_PUBLIC_KEY=      # browser push for admins; make a pair with: python -m scripts.vapid_keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@plasticash.app
FRONTEND_ORIGIN=http://localhost:3000
MIN_WITHDRAWAL_KOBO=100000
DOOR_MIN_KG=50
AUTO_CONFIRM_HOURS=48
SMS_ENABLED=false
SEED_PASSWORD=                                 # scripts/seed.py only: password for the demo logins, 12+ chars
REDIS_URL=redis://127.0.0.1:6379/0   # rate limits and caches; empty = off. Local: docker compose up -d redis
TRUST_PROXY=false                    # true on Render (client IP from X-Forwarded-For)
